	 			column = 1   
				width = medium
			)
			Fee_Per_Head
			(
				type = decimal
				displayname = "Fee Per Head"
				initial value = 100
	 			row = 1
	 			column = 1   
				width = medium
			)
			Total_Fee
			(
				type = decimal
				displayname = "Total Fee"
	 			row = 1
	 			column = 1   
				width = medium
    			Formula_Properties
    			(
    						value =  input.Number_of_Participants * input.Fee_Per_Head
    						visibility = true
    			)
			)
			plain5
			(
    			type = plaintext
				value = "<div><b>PARTICIPANT REQUIREMENTS</b><br /></div>"
	 			row = 1
	 			column = 1   
				width = medium
			)
			Interests
			(
				type = list	
				values = {"AI","Web","Cloud","Cybersecurity","IoT"}
				height = 60px
	 			row = 1
	 			column = 1   
				width = medium
			)
			Special_Requirements
			(
    			type = textarea
				displayname = "Special Requirements"
				height = 100px
	 			row = 1
	 			column = 1   
				width = medium
			)
			must have Agree_to_Terms
			(
    			type = checkbox
				displayname = "Agree to Terms"
				initial value = false
	 			row = 1
	 			column = 1   
				width = medium
			)
	
			actions
			{
				on add
				{
					submit
					(
   						type = submit
   						displayname = "Submit"
					)
				}
				on edit
				{
					update
					(
   						type = submit
   						displayname = "Update"
					)
					cancel
					(
   						type = cancel
   						displayname = "Cancel"
					)
				}
			}
		}
		form Events
		{
			success message = "Event Added Successfully"
			Section
			(
				type = section
	 			row = 1
	 			column = 0   
				width = medium
			)
			must have unique Event_Name
			(
    			type = text
				displayname = "Event Name"
	 			row = 1
	 			column = 1   
				width = medium
			)
			Event_Description
			(
    			type = textarea
				displayname = "Event Description"
				height = 100px
	 			row = 1
	 			column = 1   
				width = medium
			)
			must have Event_Date
			(
    			type = date
				displayname = "Event Date"
				alloweddays = 0,1,2,3,4,5,6
	 			row = 1
	 			column = 1   
				width = medium
			)
			must have Venue
			(
    			type = text
	 			row = 1
	 			column = 1   
				width = medium
			)
			must have Maximum_Participants
			(
				type = number
				displayname = "Maximum Participants"
	 			row = 1
	 			column = 1   
				width = medium
			)
			Event_Status
			(
				type = picklist
				displayname = "Event Status"
				maxchar = 100
				values = {"Open","Closed","Completed"}
				initial value = "Open"
	 			row = 1
	 			column = 1   
				width = medium
			)
	
			actions
			{
				on add
				{
					submit
