				Registration_ID as "Registration ID"
				Participant_Name  as "Participant Name"
				Email
				Phone_Number as "Phone"
				(
					displayformat = plainnumber 
				)
				College_Name as "College Name"
				Department
				Year_of_Study as "Year of Study"
				Event
				Registration_Type as "Registration Type"
				Number_of_Participants as "Number of Participants"
				Registration_Date as "Registration Date"
				Registration_Status as "Registration Status"
				Fee_Per_Head as "Fee Per Head"
				Total_Fee as "Total Fee"
				Interests
				Special_Requirements as "Special Requirements"
				Agree_to_Terms as "Agree to Terms"
			)
			group by
			(
				Event ascending
			)
			sort by
			(
				Registration_ID ascending
			)
		}
