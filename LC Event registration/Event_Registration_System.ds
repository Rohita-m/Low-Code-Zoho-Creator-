	pages
	{
		page Event_Registration_Dashboard
		{
			displayname = "Event_Registration_Dashboard"
			Content="<zml    \t\t\n\t\t\n\t\t\n\t\t\n\t\t\n>\n\t<layout>\n\t<row>\n\t<column\n   \t\t width='100%'\n   \t>\n\t<panel elementName='Panel'\n \n >\n\t<pr \n\t\t\twidth='fill'\n\t\theight='fill'\n>\n\t<pc \n\t\tpadding = '20px'\n\tbgColor = '#FFFFFF'\n\n\t\twidth = '100%'\n\t\thAlign = 'center'\n\t\tvAlign = 'middle'\n>\n\t<pr \n\t\t\twidth='auto'\n\t\theight='auto'\n>\n\t<pc \n\t\tpadding = '5px'\n\n>\n\t<pr \n\t>\n\t<pc \n\t\n>\n\t<text \n\n\tmargin = '0px'\n\tpadding = '0px'\n\tcolor = '#FF4C2F'\n\tsize = '36px'\n\tbold = 'true' \n\ttype = 'Form Data'\n\n\tbgColor = 'transparent'\n        bgColorType = 'noFill'\n\tcornerRadius = '0px'\n\n\n\tdisplayType = 'actual'\n\tthousandsSeperator = 'LOCALE'\n\tdecimalSeperator = 'DOT'\n\tnumberScale = 'none'\n\n\n\n    borderColor = '#FF4C2F'\n    borderWidth = '0px'\n\n\t  value = 'thisapp.Event_Registration_Form.ID.count'\n>\n</text>\n\n</pc>\n</pr><pr \n\t>\n\t<pc \n\t\n>\n\t<text \n\n\tmargin = '0px'\n\tpadding = '0px'\n\tcolor = '#333333'\n\tsize = '16px'\n\ttype = 'Text'\n\n\tbgColor = 'transparent'\n        bgColorType = 'noFill'\n\tcornerRadius = '0px'\n\n\n\n\n\n    borderColor = '#333333'\n    borderWidth = '0px'\n\n\t  value = 'Total Registrations'\n>\n</text>\n\n</pc>\n</pr>\n</pc>\n</pr>\n</pc>\n</pr>\n</panel>\n</column>\n</row><row>\n\t<column\n   \t\t width='100%'\n   \t>\n\t<chart \n\telementName='Registrations by Event'\n\n\ttype = 'Column'\n\txtitle = 'Event Name'\n\tytitle = 'Registrations'\n\tbgColor = '#FFFFFF'\n\ttheme = 'theme1'\n\tlegendPos = 'center.top'\n\theightType = 'auto'\n\theightValue = '300px'\n\tappLinkName = 'thisapp'\n\tformLinkName = 'Event_Registration_Form'\n\txfield = 'Event.Event_Name'\n\tyfields = 'count:Email'\n/>\n\n</column>\n</row><row>\n\t<column\n   \t\t width='100%'\n   \t>\n\t<chart \n\telementName='Registrations by Status'\n\n\ttype = 'Pie'\n\tbgColor = '#FFFFFF'\n\ttheme = 'theme1'\n\tlegendPos = 'center.top'\n\theightType = 'auto'\n\theightValue = '300px'\n\tappLinkName = 'thisapp'\n\tformLinkName = 'Event_Registration_Form'\n\txfield = 'Registration_Status'\n\tyfields = 'count:Email'\n/>\n\n</column>\n</row><row>\n\t<column\n   \t\t width='100%'\n   \t>\n\t<chart \n\telementName='Registrations by Department'\n\n\ttype = 'Bar'\n\tbgColor = '#FFFFFF'\n\ttheme = 'theme1'\n\tlegendPos = 'center.top'\n\theightType = 'auto'\n\theightValue = '300px'\n\tappLinkName = 'thisapp'\n\tformLinkName = 'Event_Registration_Form'\n\txfield = 'Department'\n\tyfields = 'count:Email'\n/>\n\n</column>\n</row><row>\n\t<column\n   \t\t width='100%'\n   \t>\n\t<report \n\telementName='Report'\n\n\t\tappLinkName = 'thisapp'\n\t\tlinkName = 'Event_Registration_Form_Report'\n\t\n\t\tiszreport = 'false'\n\theightType = 'auto'\n\theightValue = '700'\n/>\n</column>\n</row>\n</layout>\n</zml>"
		}
	}


		 functions
		 {
			 Deluge
			 {
				 void seatsLeftReport()
                 {
                 	// Custom function: shows seats left for every event; can be called from workflows, schedules or APIs
                 	for each  ev in Events[ID != 0]
                 	{
                 		used = 0;
                 		for each  r in Event_Registration_Form[Event == ev.ID && Registration_Status == "Confirmed"]
                 		{
                 			used = used + r.Number_of_Participants;
                 		}
                 		info ev.Event_Name + " | Max: " + ev.Maximum_Participants + " | Confirmed: " + used + " | Seats left: " + (ev.Maximum_Participants - used);
                 	}
                 }
			 }
		 }


		workflow
		{
		form
		{
			Validate_Registration_and as "Validate Registration and Set Status"
			{
				type =  form
				form = Event_Registration_Form

				record event = on add

				on validate
				{
					actions 
					{
						custom deluge script
						(
											// Exp 6: validate the registration, set date and status
										if(input.Number_of_Participants < 1 || input.Number_of_Participants > 5)
										{
											alert "Number of Participants must be between 1 and 5.";
											cancel submit;
										}
										if(input.Registration_Type == "Individual" && input.Number_of_Participants != 1)
										{
											alert "Individual registration must have exactly 1 participant.";
											cancel submit;
										}
										ev = Events[ID == input.Event];
										if(ev.Event_Status != "Open")
										{
											alert "Registrations are closed for this event.";
											cancel submit;
										}
										input.Registration_Date = zoho.currentdate;
										used = 0;
										for each  r in Event_Registration_Form[Event == input.Event && Registration_Status == "Confirmed"]
										{
											used = used + r.Number_of_Participants;
										}
										if(used + input.Number_of_Participants <= ev.Maximum_Participants)
										{
											input.Registration_Status = "Confirmed";
										}
										else
										{
											input.Registration_Status = "Waitlisted";
										}
						)
					}
				}

			}
			Send_Registration_Confirm as "Send Registration Confirmation Email"
			{
				type =  form
				form = Event_Registration_Form

				record event = on add

				on success
				{
					actions 
					{
						custom deluge script
						(
											// Exp 7: send confirmation email to the participant
										ev = Events[ID == input.Event];
										pname = input.Participant_Name.first_name + " " + input.Participant_Name.last_name;
										sendmail
										[
											from :zoho.adminuserid
											to :input.Email
											subject :"Event Registration Confirmation"
											message :"Dear " + pname + ",<br><br>Thank you for registering. Your registration details are given below.<br><br>Registration ID: " + input.Registration_ID + "<br>Participant Name: " + pname + "<br>Event Name: " + ev.Event_Name + "<br>Event Date: " + ev.Event_Date + "<br>Registration Status: " + input.Registration_Status + "<br><br>Regards,<br>Event Registration Team"
										]
										// Exp 6: close the event when it is full
										used = 0;
										for each  r in Event_Registration_Form[Event == input.Event && Registration_Status == "Confirmed"]
										{
											used = used + r.Number_of_Participants;
										}
										if(used >= ev.Maximum_Participants)
										{
											ev.Event_Status="Closed";
										}
						)
					}
				}

			}
			Notify_Registration_Statu as "Notify Registration Status Change"
			{
				type =  form
				form = Event_Registration_Form

				record event = on edit

				on success
				{
					actions 
					{
						custom deluge script
						(
											// Exp 6: tell the participant the current registration status whenever the registration is updated
										ev = Events[ID == input.Event];
										sendmail
										[
											from :zoho.adminuserid
											to :input.Email
											subject :"Registration Status Updated"
											message :"Dear " + input.Participant_Name.first_name + ",<br><br>Your registration for " + ev.Event_Name + " was updated. Current status: " + input.Registration_Status + "<br><br>Regards,<br>Event Registration Team"
										]
						)
					}
				}

			}
		}






	}
