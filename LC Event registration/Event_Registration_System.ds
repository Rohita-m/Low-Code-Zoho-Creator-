 application "Event Registration System"
 {
 	date format = "dd-MMM-yyyy"
 	time zone = "Asia/Kolkata"
 	time format = "24-hr"

 	forms
	{
		form Event_Registration_Form
		{
			success message = "Data Added Successfully!"
			Section
			(
				type = section
	 			row = 1
	 			column = 0   
				width = medium
			)
			plain2
			(
    			type = plaintext
				value = "<div><b>PARTICIPANT DETAILS</b><br /></div>"
	 			row = 1
	 			column = 1   
				width = medium
			)
			Registration_ID
			(
    			type = autonumber
				displayname = "Registration ID"
				start index = 1001
	 			row = 1
	 			column = 1   
				width = medium
			)
			must have Participant_Name
			(
    			type = name
				displayname = "Participant Name"
     			prefix
     			(
	     			 type = prefix
	     			 displayname ="Prefix"
	     			 visibility = false
	     			 value = {"Mr.","Mrs.","Ms."}
     			) 
     			first_name
     			(
	     			 type = first_name
	     			 displayname ="First Name"
     			) 
     			last_name
     			(
	     			 type = last_name
	     			 displayname ="Last Name"
     			) 
     			suffix
     			(
	     			 type = suffix
	     			 displayname ="Suffix"
	     			 visibility = false
     			) 
	 			row = 1
	 			column = 1   
				width = medium
				personal data = true
			)
			plain
			(
    			type = plaintext
				value = "<div><b>CONTACT DETAILS</b><br /></div>"
	 			row = 1
	 			column = 1   
				width = medium
			)
			must have Email
			(
    			type = email
				maxchar = 80
	 			row = 1
	 			column = 1   
				width = medium
				personal data = true
			)
			must have Phone_Number
			(
    			type = phonenumber
				displayname = "Phone"
	 			row = 1
	 			column = 1   
				width = medium
				personal data = true
			)
			plain1
			(
    			type = plaintext
				value = "<div><b>ACADEMIC DETAILS</b><br /></div>"
	 			row = 1
	 			column = 1   
				width = medium
			)
			must have College_Name
			(
    			type = text
				displayname = "College Name"
	 			row = 1
	 			column = 1   
				width = medium
			)
			must have Department
			(
				type = picklist
				maxchar = 100
				values = {"CSE","IT","AIML","AIDS","ECE","MECH","EEE","CIVIL","Other"}
	 			row = 1
	 			column = 1   
				width = medium
			)
			must have Year_of_Study
			(
				type = picklist
				displayname = "Year of Study"
				maxchar = 100
				values = {"I","II","III","IV"}
	 			row = 1
	 			column = 1   
				width = medium
			)
			plain4
			(
    			type = plaintext
				value = "<div><b>EVENT DETAILS</b><br /></div>"
	 			row = 1
	 			column = 1   
				width = medium
			)
			must have Event
			(
				type = picklist	
				values  = Events.ID
    			displayformat = [Event_Name]
				sortorder = ascending
	 			row = 1
	 			column = 1   
				width = medium
			)
			plain3
			(
    			type = plaintext
				value = "<div><b>REGISTRATION DETAILS</b><br /></div>"
	 			row = 1
	 			column = 1   
				width = medium
			)
			must have Registration_Type
			(
				type = radiobuttons
				displayname = "Registration Type"
				maxchar = 100
				values = {"Individual","Team"}
	 			row = 1
	 			column = 1   
				width = medium
			)
			Registration_Date
			(
    			type = date
				displayname = "Registration Date"
				alloweddays = 0,1,2,3,4,5,6
	 			row = 1
	 			column = 1   
				width = medium
			)
			Registration_Status
			(
				type = picklist
				displayname = "Registration Status"
				maxchar = 100
				values = {"Pending","Confirmed","Waitlisted","Cancelled"}
				initial value = "Pending"
	 			row = 1
	 			column = 1   
				width = medium
			)
			must have Number_of_Participants
			(
				type = number
				displayname = "Number of Participants"
				initial value = 1
